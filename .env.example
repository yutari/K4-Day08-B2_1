# Chỉ cần một provider LLM. Nếu để trống, chatbot vẫn trả các đoạn trích có citation.

# Gemini (ưu tiên 1)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (ưu tiên 2)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# Không cần PageIndex key: Task 8 thực hiện structural fallback cục bộ để dữ liệu
# không bị gửi ra ngoài và ứng dụng vẫn hoạt động khi offline.
