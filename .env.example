# Chỉ cần một provider LLM. Nếu để trống, chatbot vẫn trả các đoạn trích có citation.

# Gemini (ưu tiên 1)
# GEMINI_API_KEY=...

# RAGAS evaluator for the four LLM-based metrics in
# group_project/evaluation/eval_pipeline.py. Use an OpenAI key or an
# OpenAI-compatible endpoint that supports both Chat Completions and Embeddings.
# Without this key (or OPENAI_API_KEY), the script records a clearly-labelled
# local cosine fallback, which is NOT a RAGAS score. To require real RAGAS, run:
# python group_project/evaluation/eval_pipeline.py --require-ragas
# RAGAS_EVALUATOR_API_KEY=sk-...
# RAGAS_EVALUATOR_MODEL=gpt-4o-mini
# RAGAS_EVALUATOR_EMBEDDING_MODEL=text-embedding-3-small
# RAGAS_EVALUATOR_BASE_URL=https://api.openai.com/v1
# GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (ưu tiên 2)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# Không cần PageIndex key: Task 8 thực hiện structural fallback cục bộ để dữ liệu
# không bị gửi ra ngoài và ứng dụng vẫn hoạt động khi offline.
